# ForgeFlow SaaS - Environment Variables Template
# Copy this file to .env.local and configure your environment-specific credentials.

# --- Database & Storage ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/industrial_seo_saas?schema=public"
NEXTAUTH_SECRET="change-this-to-a-secure-32-character-random-secret"
NEXTAUTH_URL="http://localhost:8080"
NEXT_PUBLIC_APP_URL="http://localhost:8080"

# --- Cloudflare R2 / AWS S3 (CAD File Storage & Assets) ---
R2_ACCOUNT_ID="your-r2-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET="forgeflow-cad-storage"
R2_ENDPOINT="https://your-account-id.r2.cloudflarestorage.com"

# --- Stripe Billing & Subscriptions ---
STRIPE_SECRET_KEY="sk_test_placeholder"
STRIPE_WEBHOOK_SECRET="whsec_placeholder"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_placeholder"
STRIPE_PRICE_STARTER_MONTHLY="price_starter_monthly"
STRIPE_PRICE_STARTER_ANNUAL="price_starter_annual"
STRIPE_PRICE_GROWTH_MONTHLY="price_growth_monthly"
STRIPE_PRICE_GROWTH_ANNUAL="price_growth_annual"

# --- AI Router & Model APIs ---
OPENAI_API_KEY="sk-placeholder"
ANTHROPIC_API_KEY="sk-ant-placeholder"
PERPLEXITY_API_KEY="pplx-placeholder"

# --- Analytics, Support & Observability ---
NEXT_PUBLIC_GA_MEASUREMENT_ID="G-XXXXXXXXXX"
SENTRY_DSN="https://placeholder@sentry.io/1234567"
NEXT_PUBLIC_SENTRY_DSN="https://placeholder@sentry.io/1234567"
CRISP_WEBSITE_ID=""
