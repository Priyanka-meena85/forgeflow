# ==============================================================================
# ForgeFlow - Production SaaS Configuration
# ==============================================================================

# Database: PostgreSQL Connection String
# Examples:
# - Local Docker: postgresql://postgres:postgres@localhost:5432/industrial_seo_saas?schema=public
# - Neon: postgresql://user:pass@ep-cool-fog-12345.us-east-2.aws.neon.tech/neondb?sslmode=require
# - Supabase: postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/industrial_seo_saas?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/industrial_seo_saas?schema=public"

# Public Application URL (used in email verification, password reset, and invite links)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Transactional Email (Email Verification, Password Recovery, Team Invites)
# If RESEND_API_KEY is left empty, ForgeFlow will log email actions and direct links to console in development.
RESEND_API_KEY=""
EMAIL_FROM="ForgeFlow Team <notifications@forgeflow.ai>"

# Optional AI generation provider (OpenAI / DeepSeek / Together / Ollama)
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.deepseek.com/v1"
OPENAI_MODEL="deepseek-chat"

# Optional Stripe subscription billing
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_STARTER_PRICE_ID=""
STRIPE_GROWTH_PRICE_ID=""
