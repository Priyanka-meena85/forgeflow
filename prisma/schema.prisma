generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  OWNER
  ADMIN
  REVIEWER
  AUTHOR
  MEMBER
}

enum DraftStatus {
  DRAFT
  IN_REVIEW
  CHANGES_REQUESTED
  APPROVED
  PUBLISHED
  ARCHIVED
}

enum ReviewStatus {
  PENDING
  APPROVED
  CHANGES_REQUESTED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

model Organization {
  id                    String        @id @default(cuid())
  name                  String
  slug                  String?       @unique
  website               String?
  productDescription    String?
  industry              String?
  keywords              String?
  plan                  String        @default("free")
  subscriptionStatus    String?       @default("trialing")
  monthlyPagesLimit     Int           @default(5)
  monthlyPagesUsed      Int           @default(0)
  billingCycleStart     DateTime      @default(now())
  stripeCustomerId      String?       @unique
  stripeSubscriptionId  String?       @unique
  complianceRulesJson   String?
  brandVoiceJson        String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  users                 User[]
  memberships           Membership[]
  drafts                Draft[]
  invitations           Invitation[]
  auditLogs             AuditLog[]
  reviewers             ExpertReviewer[]
  generationJobs        GenerationJob[]
  specDocuments         SpecDocument[]
  cmsIntegrations       CmsIntegration[]
  aeoTrackerQueries     AeoTrackerQuery[]
  invoiceRequests       InvoiceRequest[]

  @@index([createdAt])
}

model User {
  id                    String                @id @default(cuid())
  email                 String                @unique
  name                  String?
  passwordHash          String
  role                  UserRole              @default(OWNER)
  emailVerified         DateTime?
  image                 String?
  organizationId        String
  organization          Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sessions              Session[]
  memberships           Membership[]
  verificationTokens    VerificationToken[]
  passwordResetTokens   PasswordResetToken[]
  createdInvitations    Invitation[]          @relation("InvitedByUser")
  draftRevisions        ContentRevision[]     @relation("RevisionAuthor")
  auditLogs             AuditLog[]
  createdDrafts         Draft[]               @relation("DraftAuthor")
  generationJobs        GenerationJob[]
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  @@index([organizationId])
  @@index([email])
}

model Membership {
  id             String       @id @default(cuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role           UserRole     @default(MEMBER)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([userId, organizationId])
  @@index([organizationId])
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model VerificationToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  email     String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([email])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Invitation {
  id             String           @id @default(cuid())
  tokenHash      String           @unique
  email          String
  role           UserRole         @default(MEMBER)
  status         InvitationStatus @default(PENDING)
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedById    String
  invitedBy      User             @relation("InvitedByUser", fields: [invitedById], references: [id], onDelete: Cascade)
  expiresAt      DateTime
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([organizationId])
  @@index([email])
}

model Draft {
  id                 String            @id @default(cuid())
  organizationId     String
  organization       Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  authorId           String?
  author             User?             @relation("DraftAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  title              String
  keyword            String
  vertical           String?
  targetEquipment    String?
  complianceStandard String?
  summary            String
  sectionsJson       String
  faqsJson           String
  schemaJson         String
  status             DraftStatus       @default(IN_REVIEW)
  qaScoresJson       String?
  specRiskScore      Float?
  pipelineValueMin   Int?
  pipelineValueMax   Int?
  searchVolume       String?
  reviewComment      String?
  publishedAt        DateTime?
  publishedUrl       String?
  revisions          ContentRevision[]
  pageReview         PageReview?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@index([organizationId, createdAt])
  @@index([status])
}

model ContentRevision {
  id             String   @id @default(cuid())
  draftId        String
  draft          Draft    @relation(fields: [draftId], references: [id], onDelete: Cascade)
  revisionNumber Int
  title          String
  sectionsJson   String
  faqsJson       String
  schemaJson     String
  qaScoresJson   String?
  changeSummary  String?
  changedById    String?
  changedBy      User?    @relation("RevisionAuthor", fields: [changedById], references: [id], onDelete: SetNull)
  createdAt      DateTime @default(now())

  @@index([draftId, revisionNumber])
}

model AuditLog {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String?
  user           User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  userRole       String?
  action         String
  resourceType   String
  resourceId     String?
  metadataJson   String?
  diffJson       String?
  detailsJson    String?
  ipAddress      String?
  createdAt      DateTime     @default(now())

  @@index([organizationId, createdAt])
  @@index([resourceType, resourceId])
}

model ExpertReviewer {
  id                String        @id @default(cuid())
  organizationId    String
  organization      Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name              String
  jobTitle          String
  credentials       String
  yearsOfExperience Int           @default(5)
  linkedInUrl       String?
  photoUrl          String?
  bio               String?
  reviews           PageReview[]
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([organizationId])
}

model PageReview {
  id                    String          @id @default(cuid())
  draftId               String          @unique
  draft                 Draft           @relation(fields: [draftId], references: [id], onDelete: Cascade)
  reviewerId            String
  reviewer              ExpertReviewer  @relation(fields: [reviewerId], references: [id], onDelete: Cascade)
  status                ReviewStatus    @default(PENDING)
  reviewDate            DateTime        @default(now())
  reviewerNotes         String?
  verificationItemsJson String?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  @@index([draftId])
  @@index([reviewerId])
  @@index([status])
}

model GenerationJob {
  id                 String        @id @default(cuid())
  organizationId     String
  organization       Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId             String?
  user               User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  status             String        @default("PENDING") // PENDING, PROCESSING, COMPLETED, FAILED
  progress           Int           @default(0) // 0 to 100
  currentStep        String        @default("Queued in industrial generation pipeline")
  totalItems         Int           @default(1)
  completedItems     Int           @default(0)
  inputDataJson      String        // serialized topics & parameters
  resultDraftIdsJson String?       // serialized array of generated draft IDs
  error              String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@index([organizationId, createdAt])
  @@index([status])
}

model SpecDocument {
  id                 String        @id @default(cuid())
  organizationId     String
  organization       Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  title              String
  fileName           String
  fileSize           Int           @default(0)
  fileType           String        @default("pdf")
  extractedContent   String
  extractedNodesJson String?
  status             String        @default("PARSED") // PARSED, INDEXED, FAILED
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@index([organizationId, createdAt])
}

model CmsIntegration {
  id                  String        @id @default(cuid())
  organizationId      String
  organization        Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  provider            String        // WORDPRESS, WEBFLOW, HUBSPOT, CUSTOM_WEBHOOK
  name                String
  endpointUrl         String
  apiKey              String?
  targetCollectionId  String?
  status              String        @default("CONNECTED") // CONNECTED, ERROR
  autoPublishApproved Boolean       @default(false)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  @@index([organizationId])
}

model AeoTrackerQuery {
  id                      String        @id @default(cuid())
  organizationId          String
  organization            Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  draftId                 String?
  keyword                 String
  targetUrl               String
  googleAeoCited          Boolean       @default(false)
  googleAeoPosition       Int?
  perplexityCited         Boolean       @default(false)
  perplexityCitationIndex Int?
  chatGptIndexed          Boolean       @default(false)
  aiSnippetSummary        String?
  lastCheckedAt           DateTime      @default(now())
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt

  @@index([organizationId, lastCheckedAt])
}

model InvoiceRequest {
  id                  String        @id @default(cuid())
  organizationId      String
  organization        Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  companyName         String
  billingContactName  String
  billingEmail        String
  purchaseOrderNumber String?
  taxIdOrGst          String?
  plan                String        // GROWTH_ANNUAL, FLEET_ANNUAL, ENTERPRISE_CUSTOM
  amountUsd           Int
  paymentTerms        String        @default("NET_30")
  status              String        @default("PENDING") // PENDING, INVOICED, PAID, CANCELED
  invoicePdfUrl       String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  @@index([organizationId, createdAt])
}
