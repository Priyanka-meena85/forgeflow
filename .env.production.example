# ==============================================================================
# FORGEFLOW ENTERPRISE PRODUCTION ENVIRONMENT TEMPLATE (.env.production)
# ==============================================================================
# Copy this file to .env.production on your production server (Vercel, AWS ECS, Railway, or VPS).

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION RUNTIME
# ------------------------------------------------------------------------------
NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://forgeflow.ai
PORT=8080

# 64-character random cryptographic string for JWT/Session signing
# Generate with: openssl rand -hex 32
AUTH_SECRET=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
SESSION_SECRET=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ------------------------------------------------------------------------------
# 2. HIGH-AVAILABILITY DATABASE (SUPABASE / NEON / AWS RDS PROXY)
# ------------------------------------------------------------------------------
# MANDATORY: Must include connection_limit and pgbouncer=true to prevent serverless pool exhaustion
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT]:[YOUR-PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=20&pool_timeout=10"
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT]:[YOUR-PASSWORD]@aws-0-us-east-1.pooler.supabase.com:5432/postgres"

# ------------------------------------------------------------------------------
# 3. STRIPE ENTERPRISE BILLING & NET-30 INVOICING
# ------------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_live_51...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_51...
STRIPE_WEBHOOK_SECRET=whsec_...

# ------------------------------------------------------------------------------
# 4. TRANSACTIONAL EMAIL (RESEND / AMAZON SES)
# ------------------------------------------------------------------------------
RESEND_API_KEY=re_live_...
EMAIL_FROM="ForgeFlow Enterprise <notifications@forgeflow.ai>"

# ------------------------------------------------------------------------------
# 5. LIVE AI CITATION & SERP HARVESTING CLUSTER
# ------------------------------------------------------------------------------
# Option A: DataForSEO API (Recommended for live ChatGPT & Google AI Overview citation tracking)
# Format: login:password
DATAFORSEO_API_KEY=""

# Option B: BrightData Headless Residential Proxy Webhook (Fallback)
BRIGHTDATA_PROXY_URL=""

# ------------------------------------------------------------------------------
# 6. SENTRY / CLOUDWATCH APM TELEMETRY
# ------------------------------------------------------------------------------
SENTRY_DSN=https://example@o123456.ingest.sentry.io/123456
NEXT_PUBLIC_SENTRY_DSN=https://example@o123456.ingest.sentry.io/123456

# ------------------------------------------------------------------------------
# 7. CAD IP DATA SOVEREIGNTY & ITAR COMPLIANCE
# ------------------------------------------------------------------------------
# When true, raw 3D mesh vertices are completely purged from RAM within 60s
ENABLE_CAD_ZERO_RETENTION=true
ITAR_COMPLIANCE_ENFORCEMENT=true
